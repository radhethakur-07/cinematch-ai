# ==============================================================================
# CineMatch AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env in your backend and frontend directories as needed.
# NEVER commit .env files containing real secret keys to Git.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configured on Vercel / local frontend/.env)
# ------------------------------------------------------------------------------
# Backend API Base URL (DO NOT hardcode localhost in production)
# Local: http://localhost:8000
# Production: https://your-render-backend-url.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Public Keys (Safe for frontend exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configured on Render / local backend/.env)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Supabase Database Direct PostgreSQL URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./cinematch_dev.db

# Supabase Auth & Service Role (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# TMDB (The Movie Database) API Key for real-time movie ingestion and metadata
TMDB_API_KEY=your_tmdb_api_key_v3_here

# Google Gemini API Key for Natural Language Movie Discovery
GEMINI_API_KEY=your_google_gemini_api_key_here

# CORS Allowed Origins (Comma separated in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cinematch-ai.vercel.app

# Hybrid Recommendation Model Scoring Weights (Sum to 1.0)
W_CONTENT=0.40
W_COLLAB=0.30
W_USER=0.15
W_RATING=0.10
W_RECENCY=0.05
